# Harbor-Master keys. Copy this file to secrets.env in the same folder (hm keys init does it),
# fill in what you have, and leave the rest empty.
#
# secrets.env is listed in .gitignore, so git never picks it up. Do not rename it, do not
# copy its values into protocol.toml or hm.toml, and do not paste them anywhere that is committed.
# An environment variable of the same name wins over this file.
# Where a key and a subscription are both set, the subscription is used.
# See which keys are found, and what they let this machine run, with: hm doctor

# ----- worker and frontier tiers, and the Claude Code agent. Set ONE of the two -----
# An API key, billed per token:
ANTHROPIC_API_KEY=
# Or an OAuth token for a Claude subscription, from: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# ----- decision tier (Jev, through OpenRouter) -----
OPENROUTER_API_KEY=

# ----- the Codex agent (gpt-6-astra). Set ONE of the two -----
# An API key, billed per token:
OPENAI_API_KEY=
# Or a ChatGPT subscription: sign in with `codex login`, and give the path of the file it
# writes, usually ~/.codex/auth.json. The path goes here, not the file's contents.
CODEX_AUTH_JSON_PATH=

# ----- artifact store (Hugging Face) -----
# A fine-grained token with write access to the two artifact repositories only.
HF_TOKEN=

# Harbor-Master keys. hm init makes this file as secrets.env: fill in what you have, and
# leave the rest empty.
#
# secrets.env is listed in .gitignore, so git never picks it up. Do not rename it, do not
# copy its values into protocol.toml or hm.toml, and do not paste them anywhere that is committed.
# An environment variable of the same name wins over this file.
# Where a key and a subscription are both set, the subscription is used.

# ----- worker and frontier tiers on Claude models, and the Claude Code agent. Set ONE of the two -----
# An API key, billed per token:
ANTHROPIC_API_KEY=
# Or an OAuth token for a Claude subscription, from: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# ----- decision tier (Jev, through OpenRouter) -----
OPENROUTER_API_KEY=

# ----- OpenAI models: the Codex agent, and the worker and frontier tiers when their provider is "codex" -----
# An API key, billed per token. The Codex agent can use it. The tiers cannot: they use the sign-in below.
OPENAI_API_KEY=
# A ChatGPT subscription: sign in with `codex login`, and give the path of the file it
# writes, usually ~/.codex/auth.json. The path goes here, not the file's contents.
# Left empty, ~/.codex/auth.json is still found by the tiers, but not by the Codex agent.
CODEX_AUTH_JSON_PATH=

# ----- other agents on a roster. Only the ones your roster uses -----
# Muse Code:
META_API_KEY=

# ----- task store (Hugging Face) -----
# Only if the index keeps its accepted tasks in a Hugging Face repository (`tasks` in its
# about.toml). A fine-grained token with write access to that one repository.
HF_TOKEN=
